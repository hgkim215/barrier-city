#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["door", "Collision", "building", "Outdoor", "Door", "Timeline"]
    def Material "building"
    {
        token outputs:mtlx:surface
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/building/UsdPreviewSurface.outputs:surface>

        def Shader "UsdPreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            token outputs:surface
        }
    }

    def "Outdoor" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @Outdoor.usdz@
    )
    {
        reorder nameChildren = ["Door", "Stair", "WINDOW_007", "Cube_005", "Cube_003", "WINDOW_006", "WINDOW_002", "Cube_001", "Cube_002", "WINDOW_004", "WINDOW_001", "Ramp", "BaseFloor", "Floor", "WINDOW_005", "WINDOW_008", "Cube_004", "Cube_006", "FloweBed1", "WINDOW_003", "env_light"]
        rel material:binding = </Root/building> (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0.003, 18.738884)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def "Door" (
            active = true
            customData = {
                float3 rotationEulerHint = (0, 0, 3.1415927)
            }
            prepend references = @Furnitures/Door.usdz@
        )
        {
            quatf xformOp:orient = (-4.371139e-8, 0, 0, 1)
            float3 xformOp:scale = (2, 2, 2)
            float3 xformOp:translate = (-1.8626453e-8, 6.067553, -1.39698395e-8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Xform "Collision" (
        active = true
    )
    {
        reorder nameChildren = ["Cube", "Cube_1"]
        float3 xformOp:translate = (0, 0, 18.738884)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "Cube" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/Collision/Cube/DefaultMaterial>
            double size = 0.2
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (80, 20, 1)
            float3 xformOp:translate = (0, 1.9472902, -5.9032516)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "Cube_1" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/Collision/Cube_1/DefaultMaterial>
            double size = 0.2
            float2 ui:nodegraph:node:pos = (20, 20)
            int ui:nodegraph:node:stackingOrder = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (100, 1, 100)
            float3 xformOp:translate = (0, -0.28807914, -16.417803)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def RealityKitTimeline "Timeline"
    {
        def RealityKitTrack "Track"
        {
        }
    }

    def Cube "Cube" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Cube/DefaultMaterial>
        double size = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (100, 1, 100)
        float3 xformOp:translate = (0, -0.28807914, 2.3210807)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}


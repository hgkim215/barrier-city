    def Xform "Collision" (
        active = true
    )
    {
        reorder nameChildren = ["Cube", "Cube_1"]
        float3 xformOp:translate = (0, 20, 18.738884)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "Cube" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/Collision/Cube/DefaultMaterial>
            double size = 0.2
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (80, 20, 1)
            float3 xformOp:translate = (0, 1.9472902, -5.9032516)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "Cube_1" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/Collision/Cube_1/DefaultMaterial>

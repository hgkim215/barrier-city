        rel material:binding = </Root/Cube/DefaultMaterial>
        double size = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (100, 1, 100)
        float3 xformOp:translate = (0, -0.28807914, 2.3210807)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Material "Tile"
    {
        token outputs:mtlx:surface.connect = </Root/Tile/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (335.25, 100.5)

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/Tile/TiledImage.outputs:out>
            float inputs:metallic
            float3 inputs:normal
            float inputs:opacity
            float inputs:roughness
            token outputs:out
            float2 ui:nodegraph:node:pos = (93.5, 100.5)
            int ui:nodegraph:node:stackingOrder = 1
        }

        def Shader "TiledImage"
        {
            uniform token info:id = "ND_tiledimage_color3"
            asset inputs:file = @textures/OutdoorTile.jpeg@
            float2 inputs:realworldimagesize = (0.1, 0.1)
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (-140.84766, 128.86328)
            int ui:nodegraph:node:stackingOrder = 8
        }
    }

    def Material "Wall"

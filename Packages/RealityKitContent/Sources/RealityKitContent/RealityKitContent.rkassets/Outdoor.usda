        )
        {
            rel material:binding = </Root/Tile> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "Cube_001" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/Wall_1> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

    def "Barista" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @Barista/Default.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1.5, 1.5, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "AnimationLibrary"
        {
            token info:id = "RealityKit.AnimationLibrary"

            def RealityKitAnimationFile "Walk"
            {
                uniform asset file = @Barista/Walk.usdz@
                uniform string name = "Walk"
            }

            def RealityKitAnimationFile "Greet"
            {
                uniform asset file = @Barista/Greet.usdz@
                uniform string name = "Greet"
            }
        }
    }

    def "Indoor" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @Indoor.usdz@
    )
    {
        reorder nameChildren = ["KitchenTable", "Oven", "LowerRefrigerator", "wall3", "BarTable", "_floor", "CupBoard2", "ceiling", "CupBoard1", "wall2", "AreaK", "wall4", "wall1", "BathWall1", "_Shelf", "AreaB", "BathWall2", "Cube", "env_light"]
        rel material:binding = </Root/wall> (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.077858925, 0.0030006468, 0.05167961)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/CaffeFloor> (
                bindMaterialAs = "weakerThanDescendants"
            )
            quatf xformOp:orient = (-6.123234e-17, 0, 1, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Plane" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = None (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }

        over "wall2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/CaffeFloor> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "AreaK" (

            }
            references = @furniture/Oven.usdz@
        )
        {
            quatf xformOp:orient = (-4.371139e-8, 0, 0, 1)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (-2.3501482, -5.458749, 0.8817376)

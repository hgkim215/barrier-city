            float3 rotationEulerHint = (-1.570796, 3.1415927, 0)
        }
        references = @self-service+kiosk+3d+model.usdz@
    )
    {
        reorder nameChildren = ["Screen", "tripo_node_23c6fa13_c055_4c70_b27d_10baaa65baec", "_materials"]
        quatf xformOp:orient = (-3.0908637e-8, 3.0908637e-8, 0.70710677, 0.7071068)
